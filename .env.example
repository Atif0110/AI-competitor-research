# ---- App ----
LOG_LEVEL=INFO

# ---- Scraping ----
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
# Playwright is a fallback layer: `pip install playwright && python -m playwright install chromium`

# ---- Geo-targeted proxies (Priority 3) ----
# Per-region pools; the pipeline routes region=IN -> PROXY_IN, etc.
PROXY_US=
PROXY_EU=
PROXY_UK=
PROXY_IN=
PROXY_JP=
PROXY_CA=
PROXY_AU=
PROXY_SG=
PROXY_BR=
# Generic pool used when no region matches (comma separated)
PROXY_URLS=
# JSON alternative: PROXY_REGIONS_JSON={"IN":["..."],"UK":["..."]}
# Verify the exit IP country before marking a proxy healthy (dashboard shows per-region ✓)
PROXY_VERIFY=false

# ---- Resilience ----
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_MIN_INTERVAL=1.0
PRICE_DROP_ALERT_PCT=10.0
MIN_SCRAPE_SUCCESS_RATE=0.8

# ---- LLM (fallback chain: groq -> openai -> anthropic -> structured failure) ----
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
EXTRACTION_MAX_ATTEMPTS=3

# ---- FX (Priority 12: native price kept + USD-normalized copy) ----
# EXCHANGE_RATES_JSON={"EUR":1.08,"GBP":1.27,"INR":0.012,"JPY":0.0069}

# ---- Storage ----
DATABASE_URL=sqlite:///data/competitor.db
VECTOR_STORE_DIR=data/vectors

# ---- Scheduler (Priority 13) ----
SCHEDULER_AUTOSTART=false
SCHEDULER_POLL_SECONDS=60

# ---- Output ----
REPORT_OUTPUT_DIR=data/reports
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Production PostgreSQL / RAG ----
# PostgreSQL is the production backend. SQLite remains useful for offline demo mode.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitor
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- API security ----
# Generate a long random value for production. The API refuses to start in live mode
# when API_KEY_REQUIRED=true but API_KEY is missing.
API_KEY=
API_KEY_REQUIRED=true
CORS_ORIGINS=http://localhost:5173
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_RATE_LIMIT_PER_MINUTE=5
