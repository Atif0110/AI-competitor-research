# Application
LOG_LEVEL=INFO

# Scraping
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# Regional proxies
PROXY_US=
PROXY_EU=
PROXY_UK=
PROXY_IN=
PROXY_JP=
PROXY_CA=
PROXY_AU=
PROXY_SG=
PROXY_BR=
PROXY_URLS=
PROXY_VERIFY=false

# Resilience
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_MIN_INTERVAL=1.0
PRICE_DROP_ALERT_PCT=10.0
MIN_SCRAPE_SUCCESS_RATE=0.8

# LLM
LLM_PROVIDER=auto
DEMO_MODE=false

# APInex — OpenAI-compatible gateway, free tier first.
# Free models: free/all, free/gpt-6-luna, free/gpt-5.6-luna, free/claude-sonnet-4.6,
# free/gemini-3.8-flash, free/deepseek-v4.1-flash, free/glm-5.3-flash, free/kimi-k3
APINEX_API_KEY=
APINEX_BASE_URL=https://apinex.bond/v1
APINEX_MODEL=free/all
# APInex web tools (/tools/web/search, /tools/web/contents, /tools/web/research)
APINEX_WEB_TOOLS=false
APINEX_TIMEOUT_SECONDS=90
APINEX_MAX_OUTPUT_TOKENS=4096

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

EXTRACTION_MAX_ATTEMPTS=3

# Deep research engine (URL / topic / comparison runs)
DEEP_LLM_ENABLED=true
DEEP_MAX_PAGES=12
DEEP_MAX_PAGES_PER_HOST=8
DEEP_MAX_DEPTH=2
DEEP_CONCURRENCY=3
DEEP_PER_HOST_DELAY=1.0
DEEP_PAGE_CHAR_BUDGET=14000
DEEP_STORE_CHAR_BUDGET=40000
DEEP_MIN_CONTENT_CHARS=400
DEEP_RESPECT_ROBOTS=true
DEEP_SEARCH_ENABLED=true
DEEP_SECTION_MIN_CHARS=120
DEEP_CHUNK_CHARS=1100
DEEP_CHUNK_OVERLAP=150

# Research chat (RAG over a stored run)
CHAT_TOP_K=6
CHAT_CONTEXT_CHARS=14000
CHAT_HISTORY_TURNS=6
CHAT_MIN_RELEVANCE=0.15
CHAT_MIN_COVERAGE=0.34

# Storage
DATABASE_URL=sqlite:///data/competitor.db
VECTOR_STORE_DIR=data/vectors
CHECKPOINT_DIR=data/checkpoints

# RAG / embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Scheduler
SCHEDULER_AUTOSTART=false
SCHEDULER_POLL_SECONDS=60

# Output / notifications
REPORT_OUTPUT_DIR=data/reports
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional FX overrides
EXCHANGE_RATES_JSON=

# API security
API_KEY=
API_KEY_REQUIRED=true
CORS_ORIGINS=http://localhost:5173
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_RATE_LIMIT_PER_MINUTE=5
