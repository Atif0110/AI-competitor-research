# Application
LOG_LEVEL=INFO

# Scraping
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# Regional proxies
PROXY_US=
PROXY_EU=
PROXY_UK=
PROXY_IN=
PROXY_JP=
PROXY_CA=
PROXY_AU=
PROXY_SG=
PROXY_BR=
PROXY_URLS=
PROXY_VERIFY=false

# Resilience
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_MIN_INTERVAL=1.0
PRICE_DROP_ALERT_PCT=10.0
MIN_SCRAPE_SUCCESS_RATE=0.8

# LLM
LLM_PROVIDER=auto
DEMO_MODE=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

EXTRACTION_MAX_ATTEMPTS=3

# Storage
DATABASE_URL=sqlite:///data/competitor.db
VECTOR_STORE_DIR=data/vectors

# RAG / embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Scheduler
SCHEDULER_AUTOSTART=false
SCHEDULER_POLL_SECONDS=60

# Output / notifications
REPORT_OUTPUT_DIR=data/reports
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional FX overrides
EXCHANGE_RATES_JSON=

# API security
API_KEY=
API_KEY_REQUIRED=true
CORS_ORIGINS=http://localhost:5173
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_RATE_LIMIT_PER_MINUTE=5
